{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && HF_HOME=./artifacts/hf_cache python - <<'PY'\nimport re, collections, os, sys\nfrom datasets import load_from_disk\nfrom transformers import AutoTokenizer\nmodel_name='Qwen/Qwen2.5-0.5B'\nprint('loading tokenizer', model_name)\ntok=AutoTokenizer.from_pretrained(model_name, trust_remote_code=True)\nprint('vocab', len(tok), 'pad', tok.pad_token_id, 'eos', tok.eos_token_id)\nds=load_from_disk('datasets/wikitext2_raw')\npattern=re.compile(r\\\"[A-Za-z][A-Za-z'-]{3,}\\\")\ncounts=collections.Counter()\nfor row in ds['train']:\n    text=row['text']\n    if not text or not text.strip() or text.strip().startswith('='):\n        continue\n    for m in pattern.finditer(text):\n        w=m.group(0).strip(\\\"'-\\\").lower()\n        if len(w)>=5 and w.isalpha():\n            counts[w]+=1\nmulti=[]\nfinal_groups=collections.defaultdict(list)\nfor w,c in counts.items():\n    ids=tok.encode(' '+w, add_special_tokens=False)\n    single=tok.encode(w, add_special_tokens=False)\n    if c>=4 and len(ids)>=2 and len(single)>=2:\n        multi.append((w,c,ids,tok.convert_ids_to_tokens(ids)))\n        final_groups[ids[-1]].append((w,c,ids))\nprint('word types total', len(counts), 'multi>=4', len(multi))\nfor thresh in [2,3,4]:\n    ntypes=sum(len(v) for v in final_groups.values() if len(v)>=thresh)\n    ngroups=sum(1 for v in final_groups.values() if len(v)>=thresh)\n    print('final group >=',thresh,'groups',ngroups,'types',ntypes)\nprint('top examples')\nfor item in sorted(multi, key=lambda x:-x[1])[:30]:\n    print(item[0], item[1], item[3])\nprint('top final groups')\nfor fid, vals in sorted(final_groups.items(), key=lambda kv:-len(kv[1]))[:10]:\n    print(fid, tok.convert_ids_to_tokens([fid]), len(vals), sorted([(w,c) for w,c,_ in vals], key=lambda x:-x[1])[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
