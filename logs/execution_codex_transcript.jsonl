{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"pwd && source .venv/bin/activate && python - <<'PY'\nimport json, csv, numpy as np\nfrom scipy import stats\n\ndef norm(x):\n    return x / np.maximum(np.linalg.norm(x, axis=-1, keepdims=True), 1e-8)\n\ndef scores_correct(scores, labels):\n    return np.argmax(scores, axis=1) == labels\n\ndef bootstrap(vals, n=5000, seed=123):\n    rng=np.random.default_rng(seed)\n    vals=np.asarray(vals, dtype=np.float32)\n    idx=rng.integers(0,len(vals),size=(n,len(vals)))\n    boot=vals[idx].mean(axis=1)\n    return [float(np.percentile(boot,2.5)), float(np.percentile(boot,97.5))]\n\ndef rand_p(a,b,n=10000,seed=456):\n    rng=np.random.default_rng(seed)\n    diffs=a.astype(np.float32)-b.astype(np.float32)\n    obs=abs(float(diffs.mean()))\n    if obs==0: return 1.0\n    count=0\n    batch=1000\n    done=0\n    while done<n:\n        k=min(batch,n-done)\n        signs=rng.choice(np.array([-1,1],dtype=np.float32),size=(k,len(diffs)))\n        count += int(np.sum(np.abs((signs*diffs).mean(axis=1)) >= obs))\n        done += k\n    return float((count+1)/(n+1))\n\ndef mcnemar(a,b):\n    a=a.astype(bool); b=b.astype(bool)\n    a_only=int(np.sum(a & ~b)); b_only=int(np.sum(~a & b)); disc=a_only+b_only\n    p=1.0 if disc==0 else float(stats.binomtest(min(a_only,b_only), disc, 0.5).pvalue)\n    return {'a_only':a_only,'b_only':b_only,'discordant':disc,'p_value':p}\n\ncache=np.load('results/hidden_states_Qwen_Qwen2p5-0p5B_words128_ex2048_seed42_len96.npz')\ntables=np.load('results/implicit_vocab_tables.npz')\nH=cache['hidden_states'].astype(np.float32); labels=cache['labels']; split=cache['split']\nmask=split=='test'; y=labels[mask]\nprototypes=tables['prototypes']; layer_prototypes=tables['layer_prototypes']; mean_emb=tables['mean_subtoken_embeddings']\ncomparisons={}\nmethods={\n    'itl_layer5': norm(H[mask,5,:]) @ layer_prototypes[5].T,\n    'raw_final_layer22': norm(H[mask,22,:]) @ prototypes.T,\n    'raw_final_layer5': norm(H[mask,5,:]) @ prototypes.T,\n    'mean_subtoken_layer0': norm(H[mask,0,:]) @ mean_emb.T,\n}\ncorrect={k:scores_correct(v,y) for k,v in methods.items()}\nfor name,c in correct.items():\n    comparisons[name]={'accuracy':float(c.mean()), 'ci95':bootstrap(c)}\nfor base in ['raw_final_layer22','raw_final_layer5','mean_subtoken_layer0']:\n    diff=correct['itl_layer5'].astype(np.float32)-correct[base].astype(np.float32)\n    comparisons[f'itl_layer5_vs_{base}']={\n        'accuracy_difference':float(diff.mean()),\n        'diff_ci95':bootstrap(diff),\n        'paired_randomization_p':rand_p(correct['itl_layer5'], correct[base]),\n        'mcnemar_exact':mcnemar(correct['itl_layer5'], correct[base]),\n    }\njson.dump(comparisons, open('results/additional_comparisons.json','w'), indent=2)\nprint(json.dumps(comparisons, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
