{"type":"item.started","item":{"id":"item_130","type":"command_execution","command":"/bin/bash -lc \"pwd && source .venv/bin/activate && python - <<'PY'\nfrom datasets import load_dataset\nfrom pathlib import Path\nimport json, shutil\n\nroot = Path('datasets')\nroot.mkdir(exist_ok=True)\n\nconfigs = [\n    ('wikitext2_raw', lambda: load_dataset('wikitext', 'wikitext-2-raw-v1')),\n    ('glue_sst2', lambda: load_dataset('glue', 'sst2')),\n]\n\n# Try known LAMBADA identifiers in order.\ndef load_lambada():\n    errors = []\n    for args in [('EleutherAI/lambada_openai',), ('lambada',), ('cimec/lambada',)]:\n        try:\n            return load_dataset(*args)\n        except Exception as exc:\n            errors.append(f\\\"{args}: {exc}\\\")\n    raise RuntimeError('All LAMBADA attempts failed:\\\\n' + '\\\\n'.join(errors))\n\nconfigs.append(('lambada_openai', load_lambada))\n\nsummary = {}\nfor name, loader in configs:\n    out = root / name\n    if out.exists():\n        shutil.rmtree(out)\n    print(f'Loading {name}...')\n    ds = loader()\n    ds.save_to_disk(str(out))\n    info = {split: len(ds[split]) for split in ds.keys()}\n    summary[name] = info\n    sample_dir = out / 'samples'\n    sample_dir.mkdir(parents=True, exist_ok=True)\n    samples = {}\n    for split in ds.keys():\n        n = min(5, len(ds[split]))\n        samples[split] = [ds[split][i] for i in range(n)]\n    with (sample_dir / 'examples.json').open('w', encoding='utf-8') as f:\n        json.dump(samples, f, indent=2, ensure_ascii=False)\n    print(f'Saved {name}: {info}')\n\nwith (root / 'dataset_summary.json').open('w', encoding='utf-8') as f:\n    json.dump(summary, f, indent=2)\nprint('SUMMARY', json.dumps(summary, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
